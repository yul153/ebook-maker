<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   웹 이북 서버 설정 (IIS · 윈도우 서버 전용)

   .htaccess는 아파치 서버에서만 읽힙니다. 서버가 IIS면 아무 효과가 없어서,
   같은 내용을 IIS 문법으로 한 번 더 적어 둔 파일이 이 web.config 입니다.
   이북 폴더 안에 함께 올려 두기만 하면 됩니다. (아파치 서버에서는 그냥
   읽히지 않는 파일로 남습니다.)

   ※ 만약 이 파일을 올린 뒤 폴더 전체가 "500 - 내부 서버 오류"로 뜬다면,
     그 서버는 하위 폴더에서 이 설정을 바꾸지 못하도록 잠가 둔 것입니다.
     그때는 이 파일을 지우고, 서버 담당자에게 아래 한 가지만 요청하세요.

         "IIS 관리자 → MIME 형식에 확장자 .webp / 형식 image/webp 추가"

     또는 이북을 JPG 형식으로 다시 만들어 올리면 서버 설정 없이 바로 보입니다.
  ============================================================================
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- remove를 먼저 적는 이유: 상위 설정에 이미 같은 확장자가 있으면
           IIS가 "중복 항목"으로 보고 500 오류를 냅니다. 지우고 다시 넣으면
           있든 없든 안전합니다. -->

      <!-- ① .webp — 이게 없으면 쪽 이미지가 통째로 404가 되어 그림이
           전부 엑스박스로 뜹니다. 이북이 안 보이는 가장 흔한 원인. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />

      <!-- ② manifest.json · search.json — 목차·검색이 여기에 들어 있습니다. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
